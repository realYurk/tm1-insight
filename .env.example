# ============ TM1 连接 ============
TM1_ADDRESS=            # ← 必填：TM1 服务器地址
TM1_PORT=               # ← 必填：TM1 HTTP 端口
TM1_USER=               # ← 必填：登录用户名
TM1_PASSWORD=           # ← 必填：登录密码（绝不明文提交到版本库）
TM1_SSL=false
TM1_NAMESPACE=          # ← 可选：CAM 命名空间（如需要）

# ============ 采集 ============
TM1_MAX_WORKERS=8
TM1_SKIP_EXISTING=true
TM1_LIGHT_SYSTEM_DIMS=true

# ============ 本地数据目录（相对 tm1-suite 根目录） ============
DATA_DIR=./data
# 手动拷贝的本地输入文件（无法通过 TM1 HTTP 获取）
INPUT_APPLICATIONS_DIR=./data/inputs/applications
INPUT_EXTERNALS_DIR=./data/inputs/externals
INPUT_PROCESS_DIR=./data/inputs/process
INPUT_RUX_DIR=./data/inputs/rux

# ============ Web 服务 ============
WEB_HOST=0.0.0.0
WEB_PORT=8000
